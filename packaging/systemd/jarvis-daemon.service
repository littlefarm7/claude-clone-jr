# Serviço de usuário (não requer root):
#   mkdir -p ~/.config/systemd/user && cp jarvis-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now jarvis-daemon
[Unit]
Description=Jarvis Core — agendamentos
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/jarvis daemon --non-interactive
Restart=on-failure
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
